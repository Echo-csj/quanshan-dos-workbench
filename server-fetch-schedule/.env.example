# 课程表抓取服务配置（复制为 .env 后填入真实值）
# 所有项均为必填；敏感项（SERVICE_ROLE_KEY / SOURCE_USER / SOURCE_PASS）请勿外传。

# 自建 Supabase 地址（本机运行写 127.0.0.1:8000 最稳，直连绕过 WAF/防火墙）
SUPABASE_URL=http://127.0.0.1:8000

# 自建实例 service_role key（来自重装输出 SERVICE_ROLE_KEY，绕过 RLS 写库）
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3ODkxOTUzOTksImV4cCI6NDEwMjQ0NDgwMH0.95lg6rRWWNpAq77XTO9Ejo_Gf3admQuL5orgqd6_pgA

# 自建 DOS 主账号的 user_id（来自 Authentication → Users）
OWNER_USER_ID=2a747013-3625-4a24-8800-aa845ee95dbe

# 触发口令（前端 config.js 的 CRON_SECRET 须与之相同）
CRON_SECRET=daily-fetch-2026

# 91paike 源站
SOURCE_BASE_URL=http://zyg.91paike.com
SOURCE_MODULE=400002
SOURCE_USER=你的91paike账号
SOURCE_PASS=你的91paike密码

# 可选
# FETCH_PORT=28888
# FETCH_SCHEDULE=06:00
# ALLOW_ORIGIN=https://echo-csj.github.io
